---
import Sheet from '../layouts/Sheet.astro';
import Plan from '../components/Plan.astro';
import Door from '../components/Door.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { href } from '../lib/url';
import { sheets } from '../data/sheets';
const projects = await getCollection('projects');
---
<Sheet room="plan">
  <section class="home">
    <p class="mono cap home-meta"><b>A-01</b> Ground floor plan · Scale 1:100 · North up</p>

    <h1 class="display home-name" aria-label={site.name}>
      <span class="first">Rifat</span>
      <span class="last"><em>Hasan</em></span>
    </h1>

    <div class="home-plan">
      <Plan mode="full" artifacts={projects.length} />
    </div>

    <ol class="home-index">
      {sheets.slice(1).map((s) => (
        <li><a href={href(s.path)} data-room={s.room}><span class="mono">{s.no.slice(2)}</span><span class="nm">{s.name}</span><span class="mono cap">{s.label}</span></a></li>
      ))}
    </ol>

    <div class="home-intro">
      <p class="lede">I build software for Los Angeles County by day and a few other things after hours. This is the floor plan: six rooms, one door, and whatever light Los Angeles has right now.</p>
      <p class="home-go">
        <a class="go" href={href('/work/')}><Door />Start in the workshop</a>
        <span class="mono hint">or pick a room · <kbd>?</kbd> legend</span>
      </p>
    </div>
  </section>
</Sheet>

<script>import '../scripts/plan-light.ts';</script>

<style>
  .home {
    min-height: 100svh;
    padding: clamp(1.1rem, 2.4vw, 2rem) clamp(1.1rem, 3vw, 3rem) 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr) auto;
    position: relative;
  }
  .home-meta { position: relative; z-index: 3; }
  .home-name { pointer-events: none; display: contents; }
  .home-name span { position: absolute; z-index: 2; font-size: clamp(4.2rem, 15.5vmin + 3vw, 13.5rem); }
  .home-name .first { left: clamp(0.9rem, 2.4vw, 2.6rem); top: clamp(2.6rem, 6vh, 4.5rem); }
  .home-name .last { right: clamp(0.9rem, 2.4vw, 2.6rem); bottom: clamp(1rem, 4vh, 3rem); color: var(--accent); }
  .home-plan {
    grid-row: 2; align-self: center; justify-self: center; view-transition-name: plan;
    width: min(100%, calc((100svh - 13rem) * 1.45)); margin-block: 1rem;
    padding-left: clamp(0rem, 6vw, 5rem);
  }
  .home-index { display: none; }
  .home-intro { grid-row: 3; max-width: 25rem; position: relative; z-index: 3; padding-bottom: clamp(1.2rem, 3vh, 2.4rem); display: grid; gap: 1.2rem; }
  .lede { font-size: 1rem; line-height: 1.55; text-wrap: pretty; }
  .home-go { display: flex; flex-wrap: wrap; gap: 0.8rem 1.4rem; align-items: center; }
  .hint { color: var(--graphite); }

  @media (prefers-reduced-motion: no-preference) {
    .home-name span { animation: rise 1.1s var(--ease) both; }
    .home-name .last { animation-delay: 0.15s; }
    .home-intro { animation: rise 1s 0.35s var(--ease) both; }
  }

  @media (max-width: 960px) {
    .home { min-height: calc(100svh - 3.5rem); display: flex; flex-direction: column; gap: 0.5rem; }
    .home-name { display: flex; flex-direction: column; margin-top: 1.2rem; }
    .home-name span { position: static; font-size: clamp(4.4rem, 23vw, 9rem); }
    .home-name .last { align-self: flex-end; margin-top: -0.12em; }
    .home-plan { width: 100%; padding: 0; margin-block: 1.2rem 1.6rem; }
    .home-intro { max-width: 30rem; }
    .hint { display: none; }
    .home-index { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); order: 5; margin-top: 1.5rem; }
    .home-index a { display: grid; grid-template-columns: 1.8rem 1fr; padding: 0.8rem 0; border-bottom: 1px solid var(--hair); text-decoration: none; }
    .home-index .mono:first-child { color: var(--accent); grid-row: span 2; padding-top: 0.3rem; }
    .home-index .nm { font: 400 1.15rem/1.2 var(--serif); }
    .home-index .cap { font-size: 0.62rem; }
    :global(.plan--full .plan-anno), :global(.plan--full .l-name), :global(.plan--full .l-sub) { display: none; }
    :global(.plan--full .l-no) { font-size: 40px; }
    :global(.plan--full) { margin: -6% -4% -3%; width: 108%; }
  }
</style>
