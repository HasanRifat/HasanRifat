---
import Sheet from '../../layouts/Sheet.astro';
import SheetHead from '../../components/SheetHead.astro';
import SheetFoot from '../../components/SheetFoot.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../content.config';
import { href } from '../../lib/url';
const notes = (await getCollection('notes', (n) => !n.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const used = new Set(notes.map((n) => n.data.category));
---
<Sheet room="library" title="Notes" description="A field journal by Rifat Hasan: notes on technology, design, learning and building.">
  <section class="sheet">
    <SheetHead no="A-05" label="Notes" title="Library" standfirst="A field journal. The shelves are mostly empty, which is the honest state of a new library." />

    <div class="cat" data-cat>
      <div class="filters mono" role="group" aria-label="Filter by category">
        <button type="button" aria-pressed="true" data-f="all">All <sup>{notes.length}</sup></button>
        {categories.map((c) => (
          <button type="button" aria-pressed="false" data-f={c} disabled={!used.has(c)}>{c} <sup>{notes.filter((n) => n.data.category === c).length}</sup></button>
        ))}
      </div>

      <ol class="entries">
        {notes.map((n, i) => (
          <li data-c={n.data.category}>
            <a href={href(`/notes/${n.id}/`)}>
              <span class="mono call">N-{String(notes.length - i).padStart(3, '0')}</span>
              <span class="t">{n.data.title}</span>
              <span class="s">{n.data.summary}</span>
              <span class="mono cap m"><span>{n.data.category}</span><time datetime={fmt(n.data.date)}>{fmt(n.data.date)}</time></span>
            </a>
          </li>
        ))}
        <li class="vacant" aria-hidden="true">
          <span class="mono call">N-{String(notes.length + 1).padStart(3, '0')}</span>
          <span class="s">Shelf space.</span>
        </li>
      </ol>
      <p class="none mono cap" data-none hidden>Nothing shelved under that heading yet.</p>
    </div>
  </section>
  <SheetFoot room="library" />
</Sheet>

<script>
  const cat = document.querySelector('[data-cat]');
  if (cat) {
    const btns = cat.querySelectorAll<HTMLButtonElement>('[data-f]');
    const items = cat.querySelectorAll<HTMLElement>('[data-c]');
    const none = cat.querySelector<HTMLElement>('[data-none]')!;
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let shown = 0;
      items.forEach((li) => { li.hidden = b.dataset.f !== 'all' && li.dataset.c !== b.dataset.f; if (!li.hidden) shown++; });
      none.hidden = shown > 0;
    }));
  }
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line); }
  .filters button { padding: 0.9rem 1.1rem; text-transform: uppercase; letter-spacing: 0.12em; font-weight: 500; border-right: 1px solid var(--line); }
  .filters sup { color: var(--accent); font-size: 0.9em; margin-left: 0.2em; }
  .filters button:hover:not(:disabled) { background: var(--ink); color: var(--paper); }
  .filters button[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  .filters button:disabled { color: var(--graphite); opacity: 0.55; cursor: default; }
  .entries a, .vacant {
    display: grid; grid-template-columns: 5rem minmax(0, 1.1fr) minmax(0, 1.3fr) auto; gap: 0.5rem 1.5rem; align-items: baseline;
    padding: 1.6rem 0; border-bottom: 1px solid var(--line); text-decoration: none;
  }
  .call { color: var(--accent); }
  .t { font: 300 clamp(1.8rem, 3.6vw, 3rem)/1 var(--serif); font-variation-settings: 'opsz' 144; letter-spacing: -0.03em; color: var(--ink); }
  .entries a:hover .t { font-style: italic; color: var(--accent); }
  .s { color: var(--graphite); font-size: 0.95rem; line-height: 1.5; }
  .m { display: flex; gap: 1.4rem; font-size: 0.62rem; }
  .vacant { background: repeating-linear-gradient(135deg, transparent 0 7px, var(--hair) 7px 8px); }
  .vacant .call { color: var(--graphite); padding-left: 0.6rem; }
  .none { padding: 2rem 0; }
  @media (max-width: 820px) {
    .entries a, .vacant { grid-template-columns: 4.2rem minmax(0, 1fr); }
    .s, .m { grid-column: 2; }
  }
</style>
