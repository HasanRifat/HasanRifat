---
// The signature: a door swing, as drawn on a plan. Every way through is one.
const { size = 14, class: cls = '' } = Astro.props;
---
<svg class:list={['door', cls]} width={size} height={size} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
  <path class="door-arc" d="M15 15A14 14 0 0 0 1 1" pathLength="1" />
  <line class="door-leaf" x1="1" y1="15" x2="15" y2="15" />
  <circle cx="1" cy="15" r="1" class="door-hinge" />
</svg>
